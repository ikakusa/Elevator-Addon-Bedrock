{
    "format_version": "1.21.130",
    "minecraft:entity": {
        "description": {
            "identifier": "elevator:elevator_type1_switch",
            "is_spawnable": true,
            "is_summonable": true,
            "is_experimental": false,
            "properties": {
                "property:on": {
                    "type": "bool",
                    "default": false,
                    "client_sync": true
                },
                "property:style": {
                    "type": "int",
                    "default": 0,
                    "range": [
                        0,
                        20
                    ],
                    "client_sync": true
                }
            }
        },
        "components": {
            "minecraft:damage_sensor": {
                "triggers": {
                    "cause": "all",
                    "deals_damage": "no"
                }
            },
            "minecraft:scale": {
                "value": 1.3
            },
            "minecraft:movement": {
                "value": 0.0
            },
            "minecraft:knockback_resistance": {
                "value": 1.0
            },
            "minecraft:pushable": {
                "is_pushable": false
            },
            "minecraft:collision_box": {
                "width": 0.25,
                "height": 0.5625
            },
            "minecraft:type_family": {
                "family": [
                    "elevator_item",
                    "elevator_switch"
                ]
            }
        },
        "component_groups": {
            "elevator_type1:despawn": {
                "minecraft:instant_despawn": {}
            }
        },
        "events": {
            "elevator_type1:despawn": {
                "add": {
                    "component_groups": [
                        "elevator_type1:despawn"
                    ]
                }
            },
            "minecraft:entity_spawned": {
                "queue_command": {
                    "command": [
                        "execute at @s if entity @p[r=6,rym=-45,ry=45] run tp @s ~ ~ ~ 180 0",
                        "execute at @s if entity @p[r=6,rym=45,ry=135] run tp @s ~ ~ ~ -90 0",
                        "execute at @s if entity @p[r=6,rym=135,ry=-135] run tp @s ~ ~ ~ 0 0",
                        "execute at @s if entity @p[r=6,rym=-135,ry=-45] run tp @s ~ ~ ~ 90 0",
                        "execute at @s as @s align xz run tp @s ^0.5^^"
                    ]
                }
            }
        }
    }
}